# Maintainer: aubree.wtf <https://aubree.wtf/>
pkgname=macoblox
pkgver=0.21
pkgrel=1
pkgdesc='Run the macOS Roblox client on Linux through Darling'
arch=('x86_64')
url='https://github.com/aubree-lat/MacOBlox'
license=('MIT' 'OFL-1.1')
depends=('darling' 'unzip' 'python' 'python-gobject' 'python-cairo'
         'gtk4>=4.14' 'libadwaita>=1.5' 'webkitgtk-6.0' 'sdl2' 'wayland'
         'libpulse' 'libglvnd' 'libx11' 'libxext' 'libxfixes' 'libxi' 'libxcursor' 'gcc-libs')
depends+=('hicolor-icon-theme' 'shared-mime-info' 'desktop-file-utils')
makedepends=('clang' 'lld' 'pkgconf')
optdepends=('mangohud: performance overlay'
            'mesa: Mesa EGL and Zink for the Vulkan renderer'
            'vulkan-icd-loader: Vulkan renderer loader'
            'vulkan-driver: hardware Vulkan driver for the Vulkan renderer'
            'pipewire-audio: native PipeWire audio playback')
conflicts=('macoblox-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d269a2fe5e77f6d9dfe6f9ad1281044aecb6affb868cbd9478e9efb37c21450e')

build() {
  cd "MacOBlox-$pkgver"
  MACOBLOX_BUILD_DIR="$srcdir/native-build" ./build_debug_shim.sh
}

package() {
  cd "MacOBlox-$pkgver"
  local share="$pkgdir/usr/share/macoblox"
  install -d "$share/branding"
  cp -r --no-preserve=ownership launcher "$share/"
  cp -r --no-preserve=ownership branding/icons branding/contributors "$share/branding/"
  install -m644 branding/*.png "$share/branding/"
  install -m644 patch_startup_throttle.py README.md "$share/"
  rm -f "$share/launcher/install.sh"
  python -m compileall -q -d /usr/share/macoblox/launcher "$share/launcher"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/macoblox" <<'WRAPPER'
#!/bin/sh
export MACOBLOX_PREBUILT_SHIM=/usr/lib/macoblox/shim
exec python3 /usr/share/macoblox/launcher/macoblox-launcher "$@"
WRAPPER
  chmod 755 "$pkgdir/usr/bin/macoblox"
  install -d "$pkgdir/usr/lib/macoblox/shim"
  cp -r --no-preserve=ownership "$srcdir/native-build/frameworks" \
    "$srcdir/native-build/libMacOBloxShims.dylib" \
    "$srcdir/native-build/libmacoblox-wayland.so" "$pkgdir/usr/lib/macoblox/shim/"

  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "branding/icons/macoblox-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/macoblox.png"
  done
  install -Dm644 packaging/wtf.aubree.MacOBlox.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/wtf.aubree.MacOBlox.URI.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/macoblox-roblox-window.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/wtf.aubree.MacOBlox.Studio.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/wtf.aubree.MacOBlox.xml -t "$pkgdir/usr/share/mime/packages"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 launcher/macoblox/assets/fonts/*-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/"
}
